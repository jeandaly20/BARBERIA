SECRET_KEY=una-clave-secreta-generada-por-ti
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Desarrollo local: un PostgreSQL propio.
DB_NAME=barberia_db
DB_USER=barberia_user
DB_PASSWORD=contraseña_base
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=False

# Producción (Supabase): usar el connection string del POOLER (host tipo
# aws-0-<región>.pooler.supabase.com), puerto 5432 (session mode, no 6543/transaction mode),
# y DB_SSL_REQUIRE=True. El host de "Direct connection" (db.<proyecto>.supabase.co) es
# IPv6-only y falla en la mayoría de PaaS — no usarlo. Ver README para más detalle.

EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=contraseña_de_aplicacion_gmail
OWNER_NOTIFICATION_EMAIL=tu_correo@gmail.com
# Si el hosting filtra el puerto SMTP saliente, sin esto el envío se queda colgado en vez de
# fallar rápido (y arrastra con él toda la petición de "confirmar pago"). 10s es un buen default.
EMAIL_TIMEOUT=10

# Mientras el negocio no esté aceptando pagos reales, dejar en False: las citas se confirman
# al instante (sin pasar por PayPal) y se avisa por email. Poner en True recién cuando quieras
# cobrar de verdad (con las credenciales de PayPal reales cargadas abajo).
PAGOS_REALES_HABILITADOS=False

# Credenciales de developer.paypal.com (arrancar con una app de Sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=tu_client_id_de_paypal
PAYPAL_CLIENT_SECRET=tu_client_secret_de_paypal
PAYPAL_WEBHOOK_ID=id_del_webhook_configurado_en_paypal

# URL pública desde la que PayPal debe poder alcanzar /pagos/retorno/, /pagos/cancelado/
# y /api/pagos/webhook/ (en local: http://127.0.0.1:8000; en Render: https://tu-servicio.onrender.com)
SITE_URL=http://127.0.0.1:8000

# Login con Google (console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente
# de OAuth, tipo "Aplicación web"). En "Orígenes autorizados de JavaScript" agregar
# http://127.0.0.1:8010 (o el puerto que uses en local) y la URL de Render en producción.
# Vacío = el botón de Google simplemente no se muestra.
GOOGLE_CLIENT_ID=
